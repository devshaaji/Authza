{
    "name": "authza/authza",
    "description": "A modern, plug-and-play authorization engine for PHP with precomputed permission graphs, PSR-compliant caching and logging",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Authza\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Authza\\Tests\\": "tests/"
        }
    }
}
