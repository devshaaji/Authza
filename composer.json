{
    "name": "authza/authza",
    "description": "PHP Authorization Engine - Modern, plug-and-play authorization with precomputed permission graphs",
    "type": "library",
    "license": "MIT",
    "keywords": ["authorization", "permissions", "rbac", "abac", "policy", "security"],
    "authors": [
        {
            "name": "Authza Team",
            "email": "dev@authza.dev"
        }
    ],
    "require": {
        "php": "^8.0",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/console": "^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "symfony/yaml": "For YAML DSL support (^6.0|^7.0)",
        "symfony/cache": "For advanced caching features (^6.0|^7.0)"
    },
    "autoload": {
        "psr-4": {
            "Authza\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Authza\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/authz"
    ],
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 src/ tests/",
        "cs-fix": "phpcbf --standard=PSR12 src/ tests/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
