#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaded = false;
foreach ($autoloadFiles as $autoloadFile) {
    if (file_exists($autoloadFile)) {
        require_once $autoloadFile;
        $autoloaded = true;
        break;
    }
}

if (!$autoloaded) {
    fwrite(
        STDERR,
        'You need to set up the project dependencies using Composer:' . PHP_EOL .
        '    composer install' . PHP_EOL
    );
    exit(1);
}

use Authza\Console\ConfigPathResolver;
use Authza\Console\ConsoleConfig;
use Authza\Console\ServiceContainer;

/**
 * Parse global options before Symfony Console takes over
 * This allows --config to work for all commands
 */
function parseGlobalOptions(array $argv): array
{
    $configPath = null;
    $filteredArgv = [];
    $skipNext = false;

    foreach ($argv as $i => $arg) {
        if ($skipNext) {
            $skipNext = false;
            continue;
        }

        // Handle --config=path format
        if (str_starts_with($arg, '--config=')) {
            $configPath = substr($arg, 9);
            continue;
        }

        // Handle --config path format
        if ($arg === '--config' || $arg === '-c') {
            if (isset($argv[$i + 1]) && !str_starts_with($argv[$i + 1], '-')) {
                $configPath = $argv[$i + 1];
                $skipNext = true;
                continue;
            }
        }

        $filteredArgv[] = $arg;
    }

    return [$configPath, $filteredArgv];
}

/**
 * Resolve configuration path
 * 
 * Priority order:
 * 1. --config CLI option (explicit)
 * 2. AUTHZA_CONFIG environment variable
 * 3. Remembered config path from previous init (stored in .authza file)
 */
function resolveConfigPath(?string $cliConfigPath): ?string
{
    // 1. Explicit CLI option takes highest priority
    if ($cliConfigPath !== null) {
        if (!file_exists($cliConfigPath)) {
            fwrite(STDERR, "Error: Config file not found: {$cliConfigPath}" . PHP_EOL);
            exit(1);
        }
        return $cliConfigPath;
    }

    // 2. Environment variable
    $envConfig = getenv('AUTHZA_CONFIG');
    if ($envConfig !== false && $envConfig !== '') {
        if (!file_exists($envConfig)) {
            fwrite(STDERR, "Error: Config file from AUTHZA_CONFIG not found: {$envConfig}" . PHP_EOL);
            exit(1);
        }
        return $envConfig;
    }

    // 3. Remembered config path from init command
    $rememberedConfig = ConfigPathResolver::getRememberedConfigPath();
    if ($rememberedConfig !== null) {
        return $rememberedConfig;
    }

    return null;
}

try {
    // Parse --config option from argv
    [$cliConfigPath, $filteredArgv] = parseGlobalOptions($argv);
    
    // Update argv for Symfony Console
    $argv = $filteredArgv;
    $_SERVER['argv'] = $filteredArgv;

    // Check if this is the init command (doesn't require config)
    $isInitCommand = in_array('init', $argv, true);
    
    // Resolve configuration path
    $configPath = resolveConfigPath($cliConfigPath);

    // Get version from composer.json
    $composerJsonPath = __DIR__ . '/../composer.json';
    $version = 'dev-main';
    if (file_exists($composerJsonPath)) {
        $composerJson = json_decode(file_get_contents($composerJsonPath), true);
        $version = $composerJson['version'] ?? $version;
    }

    $application = new \Symfony\Component\Console\Application('Authza CLI', $version);

    // Init command doesn't need a container
    $application->add(new \Authza\Console\InitCommand());

    // If we have a config, create the full container
    if ($configPath !== null) {
        $config = ConsoleConfig::fromFile($configPath);
        $container = new ServiceContainer($config);
        $container->bootstrap();

        // Register commands that require the container
        $application->add(new \Authza\Console\ImportCommand($container));
        $application->add(new \Authza\Console\ExportCommand($container));
        $application->add(new \Authza\Console\ValidateCommand($container));
        $application->add(new \Authza\Console\GraphBuildCommand($container));
        $application->add(new \Authza\Console\GraphInvalidateCommand($container));
        $application->add(new \Authza\Console\CacheClearCommand($container));
        $application->add(new \Authza\Console\CheckCommand($container));
        $application->add(new \Authza\Console\ListCommand($container));
        $application->add(new \Authza\Console\StatsCommand($container));
    } elseif (!$isInitCommand) {
        // No config and not init command - show error
        fwrite(
            STDERR,
            'No Authza configuration found.' . PHP_EOL .
            PHP_EOL .
            'To get started, run: authz init' . PHP_EOL .
            PHP_EOL .
            'Or provide a config file explicitly:' . PHP_EOL .
            '  authz --config=/path/to/authza.config.php <command>' . PHP_EOL .
            '  AUTHZA_CONFIG=/path/to/config.php authz <command>' . PHP_EOL
        );
        exit(1);
    }

    $application->run();
} catch (Exception $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
